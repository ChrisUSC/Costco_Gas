# Cloudflare Workers Static Assets - files listed here are never uploaded/served,
# even though assets.directory is "." (the whole repo root). Gitignore syntax.
# See: https://developers.cloudflare.com/workers/static-assets/binding/

# Python source, dependencies & test internals
*.py
requirements*.txt
pytest.ini
unconfirmed_jumps_log.jsonl

# Temporary and backup files
*.bak*
*.tmp
data_backups/


# Docs / repo metadata
README.md
.git
.github
.gitignore
.idea
.venv
.pytest_cache

# Dynamic price data snapshots (served via Cloudflare Worker/Pages from R2)
*_latest.json
*_history.json
ca_freq_*.json
ca_stores.json
local_stores.json
state_list.json




# Tests & bytecode
tests/
**/__pycache__
**/*.pyc

# Wrangler config
wrangler.jsonc
