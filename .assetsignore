# Cloudflare Workers Static Assets - files listed here are never uploaded/served,
# even though assets.directory is "." (the whole repo root). Gitignore syntax.
# See: https://developers.cloudflare.com/workers/static-assets/binding/

# Python source, dependencies & test internals
*.py
requirements*.txt
pytest.ini
unconfirmed_jumps_log.jsonl

# Temporary and backup files
*.bak*
*.tmp

# Docs / repo metadata
README.md
.git
.github
.gitignore
.idea
.venv
.pytest_cache

# Scraper-only intermediate/subset/experiment data - the frontend only ever fetches
# us_latest.json, us_stores.json, and us_history.json.
ca_latest.json
ca_history.json
ca_stores.json
ca_freq_*.json
local_latest.json
local_history.json
local_stores.json
state_list.json

# Tests & bytecode
tests/
**/__pycache__
**/*.pyc

# Wrangler config
wrangler.jsonc
