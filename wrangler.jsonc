{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costco-gas",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "r2_buckets": [
      {
        "binding": "DATA_BUCKET",
        "bucket_name": "costco-gas-data"
      }
    ]
  }
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
